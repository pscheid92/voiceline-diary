# Server
PORT=8080
# debug adds the finer live-channel detail; info is enough day to day.
LOG_LEVEL=info

# Gemini — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Notion — integration token from https://www.notion.so/profile/integrations
NOTION_TOKEN=
# 32-char hex ID from the database URL (see README for the 2-minute setup)
NOTION_DATABASE_ID=
